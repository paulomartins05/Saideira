
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUsuario {
  CONSUMIDOR
  PARCEIRO
  ADMIN
}

enum StatusResgate {
  PENDENTE
  RETIRADO
  CANCELADO
  EXPIRADO
}

enum TipoNegocio {
  RESTAURANTE
  PADARIA
  MERCADO
  DOCERIA
  OUTRO
}

enum StatusAssinatura {
  ATIVA
  CANCELADA
  INADIMPLENTE
  EXPIRADA
}


model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) 
  updatedAt     DateTime  @updatedAt
  role          RoleUsuario    @default(CONSUMIDOR)
  telefone      String?
  cnpj          String?   
  cep           String? 
  rua           String?
  numero        String?
  bairro        String?
  cidade        String?
  estado        String? 
  latitude      Float?
  longitude     Float?
  sessions      Session[]
  accounts      Account[]
  ofertas       Oferta[]
  resgates      Resgate[]
  tipoNegocio   TipoNegocio?
  assinatura    Assinatura?
}

model Assinatura {
  id                    String   @id @default(cuid())
  parceiroId            String   @unique
  parceiro              User     @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  status                StatusAssinatura @default(EXPIRADA)
  provedorPagamentoId   String?
  inicioEm              DateTime?
  renovaEm              DateTime?
  canceladaEm           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Oferta {
  id              String   @id @default(cuid())
  titulo          String   
  descricao       String   
  precoOriginal   Float    
  precoResgate   Float    
  quantidade      Int      
  dataValidade    DateTime 
  categoria       String
  localizacao     String
  latitude        Float?
  longitude       Float?
  imagemUrl       String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resgates    Resgate[]
  vendedorId      String
  vendedor        User     @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  ativo Boolean @default(true)
  @@index([vendedorId])
}

model Resgate {
  id          String   @id @default(cuid())
  userId      String
  ofertaId    String
  status      StatusResgate   @default(PENDENTE)
  quantidade  Int      @default(1)
  codigoPin   String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tentativasPin Int             @default(0)
  bloqueadoAte  DateTime?
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  oferta    Oferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([ofertaId])
  @@index([status])
}